# backend/.env.example
# Copy this file to .env and fill in real values for local development.
# On Render, set these as environment variables directly (do not upload .env).
# NEVER commit real secrets to this file.

# =========================
# DJANGO
# =========================

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-new-generated-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated. Include your Render backend domain.
# Example: your-app.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=your-render-backend-domain.onrender.com

# =========================
# DATABASE (Render PostgreSQL)
# =========================

# Render provides this automatically when you attach a PostgreSQL database.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@host:5432/dbname

# =========================
# CORS / CSRF
# =========================

# Comma-separated list of allowed frontend origins.
# Example: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Comma-separated trusted origins for CSRF protection.
# Include both the Render backend and Vercel frontend.
CSRF_TRUSTED_ORIGINS=https://your-render-backend.onrender.com,https://your-app.vercel.app

# =========================
# GEMINI AI
# =========================

GEMINI_API_KEY=your-gemini-api-key-here

# =========================
# FIREBASE ADMIN (production — env-var mode)
# =========================
# Copy these values from your Firebase service account JSON file.
# IMPORTANT: For FIREBASE_PRIVATE_KEY, paste the full key with literal \n
# sequences (do NOT expand them into real newlines in the env var value).
# Example: -----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com
